---
title: C3 - Backend module map and dependency rule
---
flowchart TB
    subgraph edge["api - HTTP edge"]
        routers["routers, deps, exception handlers<br/>no business logic"]
    end

    subgraph modules["modules - bounded by business capability"]
        identity["identity<br/>users, credentials, sessions<br/>step-up port"]
        accounts["accounts<br/>accounts, currency, ownership<br/>balance read model"]
        payments["payments<br/>transfers, beneficiaries<br/>payment state machine"]
        ledger["ledger<br/>chart of accounts, journal<br/>posting engine - THE ONLY MONEY DOOR"]
        compliance["compliance<br/>VoP, limits, screening<br/>README only in v0"]
        cards["cards<br/>README only"]
        insights["insights<br/>README only"]
        notif["notifications<br/>README only"]
    end

    subgraph caps["capabilities - SEAM 6"]
        registry["typed capability registry<br/>name, schemas, effect class, scope"]
    end

    subgraph platform["platform - shared kernel, no business rules"]
        money["money, ids, errors"]
        actors["actors - SEAM 1"]
        bus["command bus - SEAM 2"]
        policy["policy engine - SEAM 3"]
        idem["idempotency"]
        audit["audit log - SEAM 4"]
        outbox["outbox - SEAM 5"]
        obs["observability - SEAM 7"]
    end

    routers --> bus
    bus --> policy
    bus --> idem
    bus --> identity
    bus --> accounts
    bus --> payments
    payments --> ledger
    payments -.->|"port, stub adapter in v0"| compliance
    accounts --> ledger
    registry --> payments
    registry --> accounts
    registry --> insights

    modules --> platform
    caps --> platform

    classDef built fill:#1f6feb,stroke:#0b3d91,color:#ffffff
    classDef core fill:#0d7d5a,stroke:#064c37,color:#ffffff
    classDef later fill:#f5f5f5,stroke:#9e9e9e,color:#424242,stroke-dasharray: 4 3
    class identity,accounts,payments built
    class ledger core
    class compliance,cards,insights,notif later
