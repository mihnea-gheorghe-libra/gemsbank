---
title: Future agent layer - orchestrator and workers - NOT built in v0
---
flowchart TB
    user["User<br/>chat surface in the web app"]

    subgraph orchestration["services/agent-orchestrator - future"]
        orch["Orchestrator - lead agent<br/>classify intent, plan, delegate,<br/>aggregate, decide answer or propose<br/>NEVER touches the database"]

        subgraph parallel["parallel fan-out - read-only workers only"]
            support["SupportAgent<br/>RAG over product docs<br/>effect: read"]
            insights["InsightsAgent<br/>spend analysis, categorisation<br/>effect: read"]
            onboard["OnboardingAgent<br/>non-standard onboarding guidance<br/>effect: read"]
        end

        subgraph sequential["sequential - single writer"]
            pay["PaymentsAgent<br/>builds a payment PROPOSAL<br/>effect: money-moving"]
            risk["RiskAgent<br/>screens the proposal<br/>effect: read"]
        end

        escalate["Escalation to human<br/>first-class, one turn away, always visible"]
        trace["Trace store<br/>agent_runs, tokens, cost, spans"]
    end

    subgraph gateway["services/mcp-gateway - future"]
        tools["Tool list generated ONLY from<br/>the capability registry<br/>name, schemas, effect, scope"]
    end

    subgraph core["apps/api - built in v0, unchanged by the agent layer"]
        registry["Capability registry - SEAM 6"]
        bus["Command bus - SEAM 2"]
        policy["Policy engine - SEAM 3<br/>evaluates MANDATES:<br/>scope, cap, period, beneficiaries, expiry"]
        ledger["Ledger posting engine"]
        audit["Audit log + outbox"]
    end

    user --> orch
    orch --> support
    orch --> insights
    orch --> onboard
    orch --> pay
    pay --> risk
    risk --> orch
    orch --> escalate
    orch --> trace

    support --> tools
    insights --> tools
    pay --> tools
    onboard --> tools

    tools --> registry
    registry --> bus
    bus --> policy
    policy -->|"allow within mandate"| ledger
    policy -->|"outside mandate or above threshold"| confirm["Human confirmation<br/>in the web app"]
    confirm -->|"approved"| ledger
    ledger --> audit
    audit --> trace

    classDef built fill:#1f6feb,stroke:#0b3d91,color:#ffffff
    classDef core2 fill:#0d7d5a,stroke:#064c37,color:#ffffff
    classDef later fill:#f5f5f5,stroke:#9e9e9e,color:#424242,stroke-dasharray: 4 3
    classDef human fill:#b45309,stroke:#7c2d12,color:#ffffff
    class registry,bus,policy,audit built
    class ledger core2
    class orch,support,insights,onboard,pay,risk,tools,trace later
    class escalate,confirm human
