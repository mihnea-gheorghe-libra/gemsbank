MONGO_URI=
MONGO_DB_NAME=gems

# folosit doar dacă rulezi API-ul local, în afara Docker
MONGO_URI_LOCAL=

WEB_DIR=/web

RESEND_API_KEY=
OTP_FROM_EMAIL=

# Azure Document Intelligence for ID extraction
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Azure OpenAI powers SupportAgent (backend/agents/), a read-only worker that answers from the
# FAQ/user guide and the signed-in user's own profile/sessions — see README.md "Agents". Without
# these two set, only POST /agents/support/ask fails; the rest of the app is unaffected.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Azure AI Speech powers voice input (POST /agents/transcribe) and text-to-speech (POST /agents/synthesize)
# in the AI Assistant chat. This is the Speech resource, NOT Azure OpenAI: a key plus either a
# region or a resource endpoint, no deployment name. Nothing here is shared with the AZURE_OPENAI_*
# pair above. Without a key, only voice features fail — typing in the chat is unaffected.
#
# The region alone is enough:
# - STT URL: https://{region}.api.cognitive.microsoft.com/speechtotext/transcriptions:transcribe
# - TTS URL: https://{region}.tts.speech.microsoft.com/cognitiveservices/v1
# Set AZURE_SPEECH_ENDPOINT only for a custom or private-link resource host (*.cognitiveservices.azure.com).
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=
# Fast transcription. 2024-11-15 is GA; it is not offered in every region.
AZURE_SPEECH_API_VERSION=2024-11-15
# Audio is transcribed and dropped: never stored, never written to the journal. The cap is the
# ceiling on one recording; the browser stops recording on its own after 60 seconds.
SPEECH_MAX_UPLOAD_BYTES=12000000
SPEECH_TIMEOUT_SECONDS=30
SPEECH_TTS_MAX_CHARS=5000
AZURE_SPEECH_TTS_VOICE_RO=ro-RO-AlinaNeural
AZURE_SPEECH_TTS_VOICE_EN=en-US-JennyNeural

# AES-256-GCM key for the recoverable PIN, urlsafe-base64 of 32 bytes.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Empty = a well-known demo key. Never leave it empty outside local work.
PIN_ENCRYPTION_KEY=

# Rate-limit / lockout tuning. No defaults are baked into the source (config.py) on
# purpose — an attacker reading the public repo should not learn the exact thresholds.
# Ask a teammate for the values this environment uses, or pick your own for local work.
OTP_TTL_SECONDS=
OTP_RESEND_COOLDOWN_SECONDS=
OTP_MAX_RESENDS=
OTP_MAX_ATTEMPTS=

RESET_CODE_TTL_SECONDS=

SIGN_IN_MAX_FAILURES=5
SIGN_IN_LOCKOUT_SECONDS=900
REVEAL_MAX_FAILURES=5

# Sessions are opaque tokens, hashed at rest, revoked on sign-out. There is no refresh
# rotation yet, so this is also how long a signed-in tab stays usable.
SESSION_TTL_SECONDS=3600

# Money below is in integer minor units: 250000 = 2.500,00 RON.

# Onboarding opens three accounts and posts this into the RON current account from the house
# settlement account, as a real double-entry transaction. Set 0 to open the accounts empty.
DEMO_OPENING_BALANCE_MINOR=250000

# The policy engine. Above the step-up threshold a payment waits for a signature; above the
# per-transaction or rolling daily limit it is refused outright.
PAYMENT_PER_TRANSACTION_LIMIT_MINOR=5000000
PAYMENT_DAILY_LIMIT_MINOR=10000000
PAYMENT_STEP_UP_THRESHOLD_MINOR=50000

# The SCA stub. It logs the challenge and accepts this one fixed code — real SCA is future work.
STEP_UP_CODE_TTL_SECONDS=300
STEP_UP_MAX_ATTEMPTS=3
STEP_UP_DEV_CODE=000000

TRANSACTIONS_PAGE_SIZE=25
PIN_MAX_FAILURES=

PASSWORD_MAX_FAILURES=
PASSWORD_LOCKOUT_SECONDS=
PASSWORD_LOCKOUT_EXTENDED_SECONDS=

# Investments market data. Both providers are public: no key, no account.
# Yahoo's chart endpoint is unofficial; Frankfurter serves ECB reference rates.
YAHOO_CHART_BASE_URL=
FRANKFURTER_BASE_URL=
INVESTMENTS_TIMEOUT_SECONDS=6
INVESTMENTS_QUOTE_TTL_SECONDS=900
INVESTMENTS_RETRY_SECONDS=60
# Floor between two user-triggered refreshes, so the button cannot hammer the provider.
INVESTMENTS_MIN_REFRESH_SECONDS=3
INVESTMENTS_SERIES_DAYS=400

# BNR reference rates. Public, free, no key. Note the host: curs.bnr.ro, not www.bnr.ro —
# the old www path now redirects to the redesigned homepage and answers HTML.
BNR_FX_FEED_URL=https://curs.bnr.ro/nbrfxrates.xml
BNR_FX_HISTORY_FEED_URL=https://curs.bnr.ro/nbrfxrates10days.xml
# Currency rates move an order of magnitude less than vendor prices, so this threshold is
# nothing like the 8%/12% under backend/vendors/. 1.5% over 7 days is a real FX move.
FX_SIGNAL_THRESHOLD_PERCENT=0.5
FX_BASELINE_DAYS=7
# A continuing move is not re-announced while the rate stays within this of what the user
# was last told.
FX_REPEAT_RATE_TOLERANCE_PERCENT=0.5
FX_INSIGHTS_SOURCE=bnr
FX_INSIGHTS_LIMIT=3
# The page the dashboard links to as the source of an FX insight. BNR's .aspx paths now
# redirect to the homepage, so this is configuration rather than a constant.
BNR_FX_SOURCE_PAGE_URL=https://www.bnr.ro/23988-cursurile-pietei-valutare-in-format-xml
