MONGO_URI=
MONGO_DB_NAME=gems

# folosit doar dacă rulezi API-ul local, în afara Docker
MONGO_URI_LOCAL=

WEB_DIR=/web

RESEND_API_KEY=
OTP_FROM_EMAIL=

# AES-256-GCM key for the recoverable PIN, urlsafe-base64 of 32 bytes.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Empty = a well-known demo key. Never leave it empty outside local work.
PIN_ENCRYPTION_KEY=

# Rate-limit / lockout tuning. No defaults are baked into the source (config.py) on
# purpose — an attacker reading the public repo should not learn the exact thresholds.
# Ask a teammate for the values this environment uses, or pick your own for local work.
OTP_TTL_SECONDS=
OTP_RESEND_COOLDOWN_SECONDS=
OTP_MAX_RESENDS=
OTP_MAX_ATTEMPTS=

RESET_CODE_TTL_SECONDS=

PIN_MAX_FAILURES=

PASSWORD_MAX_FAILURES=
PASSWORD_LOCKOUT_SECONDS=
PASSWORD_LOCKOUT_EXTENDED_SECONDS=
