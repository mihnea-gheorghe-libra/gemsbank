MONGO_URI=mongodb://mongo:27017/gems?replicaSet=rs0
MONGO_DB_NAME=gems

MONGO_URI_LOCAL=mongodb://localhost:27017/gems?replicaSet=rs0

WEB_DIR=/web

RESEND_API_KEY=
OTP_FROM_EMAIL=onboarding@resend.dev

# AES-256-GCM key for the recoverable PIN, urlsafe-base64 of 32 bytes.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Empty = a well-known demo key. Never leave it empty outside local work.
PIN_ENCRYPTION_KEY=

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
OTP_MAX_ATTEMPTS=5

# Password-reset codes travel by email and can be slow to arrive; give them longer than the
# onboarding OTP, which is requested while the customer is already looking at the screen.
RESET_CODE_TTL_SECONDS=600

SIGN_IN_MAX_FAILURES=5
SIGN_IN_LOCKOUT_SECONDS=900
REVEAL_MAX_FAILURES=5

# Sessions are opaque tokens, hashed at rest, revoked on sign-out. There is no refresh
# rotation yet, so this is also how long a signed-in tab stays usable.
SESSION_TTL_SECONDS=3600

# Money below is in integer minor units: 250000 = 2.500,00 RON.

# Onboarding opens three accounts and posts this into the RON current account from the house
# settlement account, as a real double-entry transaction. Set 0 to open the accounts empty.
DEMO_OPENING_BALANCE_MINOR=250000

# The policy engine. Above the step-up threshold a payment waits for a signature; above the
# per-transaction or rolling daily limit it is refused outright.
PAYMENT_PER_TRANSACTION_LIMIT_MINOR=2000000
PAYMENT_DAILY_LIMIT_MINOR=5000000
PAYMENT_STEP_UP_THRESHOLD_MINOR=100000

# The SCA stub. It logs the challenge and accepts this one fixed code — real SCA is future work.
STEP_UP_CODE_TTL_SECONDS=300
STEP_UP_MAX_ATTEMPTS=3
STEP_UP_DEV_CODE=000000

TRANSACTIONS_PAGE_SIZE=25
